{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill-Desk",
  "version": "0.1.0",
  "identifier": "ca.lgraham.skilldesk",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Discover, create and manage your AI skills",
    "category": "DeveloperTool",
    "externalBin": [
      "binaries/skilldesk-service"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "windows-hooks.nsh"
      }
    },
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "publisher": "Skill-Desk contributors",
    "homepage": "https://github.com/ldgraham92/skill-desk"
  },
  "mainBinaryName": "Skill-Desk"
}
