{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill-Desk",
  "version": "0.2.6",
  "identifier": "ca.lgraham.skilldesk",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Discover, create and manage your AI skills",
    "category": "DeveloperTool",
    "externalBin": [
      "binaries/skilldesk-service"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "windows-hooks.nsh"
      }
    },
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "publisher": "Skill-Desk contributors",
    "homepage": "https://github.com/ldgraham92/skill-desk",
    "createUpdaterArtifacts": true,
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "mainBinaryName": "Skill-Desk",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1NTVCNDZGODc2MDI1RTQKUldUa0pXQ0hiN1JWRmFSZmgrQjc3QmJqQ3luZVJGSGRDbjhwL3IzeTk3L2dreElvMHllbFJkQTEK",
      "endpoints": [
        "https://raw.githubusercontent.com/ldgraham92/skill-desk/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
